# Canonical production URL used for SEO metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://amediotonomusic.com
# Optional IndexNow key. A public default is committed in src/data/indexnow.json;
# set this only to use a different one (generate with: openssl rand -hex 16).
INDEXNOW_KEY=

# Search engine ownership tokens (only the token, not the whole <meta> tag).
# Google Search Console → Settings → Ownership verification → HTML tag.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag (msvalidate.01).
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Form emails are sent through the Worker's Cloudflare Email Sending binding
# (EMAIL in wrangler.jsonc). Inbox for /trabaja-con-nosotros job applications
# (defaults to CONTACT_EMAIL in src/lib/contact.ts).
JOB_APPLICATION_EMAIL_TO=amediotonomusic@gmail.com
# Inbox for /academias proposal requests (defaults to JOB_APPLICATION_EMAIL_TO).
B2B_LEADS_EMAIL_TO=amediotonomusic@gmail.com

# Meta WhatsApp webhook verification token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
