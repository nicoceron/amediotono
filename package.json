{
  "name": "mediotono",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-blog-index.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-blog-index.mjs && node scripts/check-translations.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "content:index": "node scripts/generate-blog-index.mjs",
    "content:check": "node scripts/validate-content.mjs",
    "seo:check-ai": "node scripts/check-ai-discovery.mjs",
    "seo:check": "node scripts/check-site-seo.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:production": "sh scripts/deploy-production.sh",
    "i18n:extract": "node scripts/extract-translations.mjs",
    "i18n:overrides": "node scripts/apply-translation-overrides.mjs",
    "i18n:check": "node scripts/check-translations.mjs",
    "i18n:translate": "python3 scripts/translate-catalogs.py"
  },
  "dependencies": {
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.145.0"
  }
}
